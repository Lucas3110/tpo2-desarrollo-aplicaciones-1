# Copiá este archivo como .env y poné la URL de TU backend.
# El .env no se commitea: cada uno tiene su propia IP.
#
#   Emulador de Android  ->  http://10.0.2.2:3000/api
#     (10.0.2.2 es como el emulador ve el localhost de tu PC)
#
#   Celular fisico (QR)  ->  http://<IP-DE-TU-PC>:3000/api
#     Sacá tu IP con `ipconfig` (la IPv4 de tu red WiFi).
#     La PC y el celular tienen que estar en la misma red.
#
# Expo solo expone al codigo las variables que arrancan con EXPO_PUBLIC_.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
